---
---

<section id="inicio" class="hero-section">
  <div class="hero-inner fade-in">

    <div class="hero-content">
      <span class="hero-eyebrow">
        Nutrición Deportiva de Excelencia
      </span>

      <h1 class="hero-headline">
        <span class="hero-line-1">Alimentá tu</span>
        <span class="hero-line-2">rendimiento.</span>
      </h1>

      <p class="hero-sub">
        Planes nutricionales personalizados para deportistas que quieren ganar más.<br class="hero-br" />
        Controles, mediciones y evaluación antropométrica con mirada profesional.
      </p>

      <a href="/#reserva" class="btn-hero-primary">Reserva consulta</a>
    </div>

  </div>
</section>

<style>
  .hero-section {
    min-height: 68vh;
    background:
      linear-gradient(rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.88)),
      url('https://images.unsplash.com/photo-1512621776951-a57141f2eefd?w=1920&q=80') center / cover no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 1.5rem;
  }

  .hero-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 1200px;
    padding-top: clamp(4rem, 6vh, 5.5rem);
    padding-bottom: clamp(2rem, 3vh, 3rem);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.75rem;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: 'Manrope', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #888888;
  }

  .eyebrow-line {
    display: block;
    width: 2rem;
    height: 1px;
    background: #335c43;
    flex-shrink: 0;
  }

  .hero-headline {
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    line-height: 1;
  }

  .hero-line-1 {
    font-family: 'Dancing Script', cursive;
    font-weight: 600;
    font-size: clamp(2.8rem, 6vw, 5.5rem);
    color: #335c43;
    letter-spacing: 0.01em;
    line-height: 1.1;
  }

  .hero-line-2 {
    font-family: 'Dancing Script', cursive;
    font-weight: 700;
    font-size: clamp(3.5rem, 7.5vw, 7rem);
    color: #335c43;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .hero-sub {
    font-family: 'Manrope', sans-serif;
    font-size: clamp(0.9rem, 1.2vw, 1.05rem);
    line-height: 1.85;
    color: #666666;
    max-width: 52ch;
  }

  .hero-br {
    display: none;
  }

  @media (min-width: 640px) {
    .hero-br { display: block; }
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    background: #335c43;
    color: #fff;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 1rem 2.5rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    margin-top: 0.5rem;
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .btn-hero-primary:hover {
    background: #274d37;
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(51, 92, 67, 0.25);
  }
</style>
