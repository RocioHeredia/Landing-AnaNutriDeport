---
---

<section id="inicio" class="hero-section relative min-h-screen flex items-center overflow-hidden">

  <!-- Imagen de fondo -->
  <div class="hero-bg absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1490645935967-10de6ba17061?w=1600&h=900&fit=crop&q=80"
      alt=""
      width="1600"
      height="900"
      loading="eager"
      class="w-full h-full object-cover object-center"
    />
    <!-- Overlay orgánico -->
    <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-surface)]/90 via-[var(--color-surface)]/60 to-transparent"></div>
  </div>

  <!-- Contenido -->
  <div class="container-site relative z-10 py-32 md:py-40">
    <div class="max-w-2xl fade-in">

      <!-- Headline -->
      <h1 class="heading-display text-[var(--color-on-surface)] mb-6">
        Alimentá tu<br />
        <span class="text-[var(--color-primary)]">rendimiento.</span>
      </h1>

      <!-- Subtítulo -->
      <p class="body-lg text-[var(--color-on-surface-muted)] max-w-xl">
        Planes nutricionales personalizados para deportistas y público general. Controles, mediciones y evaluación antropométrica con mirada profesional.
      </p>

    </div>
  </div>

  <!-- Indicador scroll -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center opacity-60">
    <div class="scroll-indicator w-px h-10 bg-[var(--color-primary)] origin-top"></div>
  </div>

</section>

<style>
  .hero-section {
    background-color: var(--color-surface);
  }

  .scroll-indicator {
    animation: scrollLine 1.8s ease-in-out infinite;
  }

  @keyframes scrollLine {
    0%   { transform: scaleY(0); opacity: 1; }
    60%  { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-indicator { animation: none; }
  }
</style>
