---
---

<footer class="site-footer">

  <div class="container-site footer-body">

    <!-- Marca -->
    <div class="footer-brand">
      <a href="/" class="footer-logo-link">
        <span class="footer-brand-name">Ana Valverde</span>
        <span class="footer-brand-sub">Nutrición Deportiva</span>
      </a>
      <p class="footer-desc">
        Estrategias nutricionales personalizadas para atletas y personas activas que buscan mejorar su rendimiento y bienestar.
      </p>
    </div>

    <!-- Navegación -->
    <nav class="footer-nav">
      <h4 class="footer-heading">Secciones</h4>
      <ul>
        <li><a href="/#inicio" class="footer-link">Inicio</a></li>
        <li><a href="/#servicios" class="footer-link">Servicios</a></li>
        <li><a href="/# #testimonios" class="footer-link">Testimonios</a></li>
        <li><a href="/#faq" class="footer-link">FAQ</a></li>
        <li><a href="/#reserva" class="footer-link">Reservar turno</a></li>
      
     
      </ul>
    </nav>

    <!-- Redes -->
    <div class="footer-social">
      <h4 class="footer-heading">Seguime</h4>
      <a
        href="https://www.instagram.com/anavalverdenutrideportiva"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-ig-link"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        @anavalverdenutrideportiva
      </a>
    </div>

  </div>

  <!-- Copyright -->
  <div class="footer-bottom">
    <div class="container-site">
      <p>&copy; <span id="footer-year"></span> Ana Valverde Nutrición Deportiva. Todos los derechos reservados.</p>
    </div>
  </div>

</footer>

<script>
  const el = document.getElementById('footer-year');
  if (el) el.textContent = String(new Date().getFullYear());
</script>

<style>
  .site-footer {
    background-color: #1c3d2e;
    color: #ffffff;
  }

  .footer-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding-top: 1.75rem;
    padding-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .footer-body {
      grid-template-columns: 2fr 1fr 1fr;
      gap: 4rem;
    }
  }

  .footer-logo-link {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    line-height: 1;
  }

  .footer-brand-name {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-weight: 600;
    font-size: 1.4rem;
    color: #ffffff;
    display: block;
  }

  .footer-brand-sub {
    font-family: 'Manrope', sans-serif;
    font-weight: 500;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: rgba(255, 255, 255, 0.55);
    display: block;
  }

  .footer-desc {
    margin-top: 1.25rem;
    font-size: 0.88rem;
    color: rgba(245, 243, 240, 0.55);
    line-height: 1.7;
    max-width: 30ch;
  }

  .footer-heading {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(245, 243, 240, 0.4);
    margin-bottom: 1.25rem;
  }

  .footer-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer-link {
    font-size: 0.95rem;
    color: rgba(245, 243, 240, 0.75);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-link:hover {
    color: var(--color-white);
  }

  .footer-ig-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
    color: rgba(245, 243, 240, 0.75);
    text-decoration: none;
    transition: color 0.2s;
    line-height: 1.4;
  }

  .footer-ig-link:hover {
    color: var(--color-white);
  }

  .footer-ig-link svg {
    flex-shrink: 0;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    padding-block: 1.5rem;
  }

  .footer-bottom p {
    font-size: 0.8rem;
    color: rgba(245, 243, 240, 0.35);
    text-align: center;
  }
</style>
