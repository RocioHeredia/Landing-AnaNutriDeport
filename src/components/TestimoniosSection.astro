---
import { testimonios } from '../data/testimonios';
---

<section id="testimonios" class="testi-section">
  <div class="container-site">

    <!-- Encabezado -->
    <div class="testi-header fade-in">
      <span class="testi-eyebrow">Resultados reales</span>
      <h2 class="heading-lg testi-heading">
        Ellos ya <span class="testi-sub">dieron el salto</span>
      </h2>
    </div>

    <!-- Cards -->
    <div class="testi-grid">
      {testimonios.map((t) => (
        <article class="testi-card fade-in">
          <span class="testi-quote" aria-hidden="true">"</span>

          <div class="testi-stars" aria-label="5 estrellas">
            {'★★★★★'}
          </div>

          <p class="testi-text">{t.texto}</p>

          <footer class="testi-author">
            <span class="testi-name">{t.nombre}</span>
            <span class="testi-context">{t.contexto}</span>
          </footer>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .testi-section {
    background: #1c3d2e;
  }

  .testi-header {
    max-width: 36rem;
    margin-bottom: 4rem;
  }

  .testi-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 1rem;
  }

  .testi-heading {
    color: #fff;
  }

  .testi-sub {
    font-weight: 300;
    color: rgba(255, 255, 255, 0.6);
  }

  /* Grid */
  .testi-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .testi-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Card */
  .testi-card {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    transition: transform 0.3s ease, background 0.3s ease, border-color 0.3s ease;
  }

  .testi-card:hover {
    transform: translateY(-12px);
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.35);
  }

  .testi-quote {
    font-family: 'Cormorant Garamond', serif;
    font-size: 5rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.1);
    position: absolute;
    top: 1rem;
    right: 1.75rem;
    pointer-events: none;
    user-select: none;
  }

  .testi-stars {
    font-size: 1rem;
    color: #e6a817;
    letter-spacing: 0.1em;
  }

  .testi-text {
    font-size: 0.95rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.82);
    flex: 1;
  }

  .testi-author {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .testi-name {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    color: #fff;
  }

  .testi-context {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 500;
  }
</style>
