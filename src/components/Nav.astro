---
const navLinks = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#reserva', label: 'Reservar turno' },
];
---

<header id="main-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="nav-inner flex items-center justify-between py-3">

    <!-- Logo + texto -->
    <a href="/" aria-label="Ana Valverde Nutrición Deportiva — Inicio" class="logo-link shrink-0 flex items-center gap-3">
      <img
        src="/assets/logo.jpeg"
        alt="Ana Valverde Nutrición Deportiva"
        width="100"
        height="100"
        class="h-16 w-auto object-contain logo-img"
        loading="eager"
      />
      <span class="hidden sm:block text-xs font-semibold uppercase tracking-widest text-[var(--color-primary)]">
        Nutrición Deportiva
      </span>
    </a>

    <!-- Links desktop -->
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="nav-link text-sm font-semibold uppercase tracking-wider transition-opacity duration-200 hover:opacity-60"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Instagram -->
    <a
      href="https://www.instagram.com/anavalverdenutrideportiva"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram de Ana Valverde Nutrición Deportiva"
      class="nav-link hidden md:flex items-center gap-2 text-sm font-semibold uppercase tracking-wider transition-opacity duration-200 hover:opacity-60 pr-6"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
      </svg>
      Instagram
    </a>

    <!-- Hamburger mobile -->
    <button
      id="nav-toggle"
      class="md:hidden flex flex-col gap-1.5 p-2 mr-4"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
    >
      <span class="hamburger-line block w-6 h-0.5 bg-current transition-all duration-300"></span>
      <span class="hamburger-line block w-6 h-0.5 bg-current transition-all duration-300"></span>
      <span class="hamburger-line block w-6 h-0.5 bg-current transition-all duration-300"></span>
    </button>
  </div>

  <!-- Menú mobile -->
  <div id="mobile-menu" class="hidden md:hidden bg-[var(--color-surface)] border-t border-[var(--color-surface-high)]">
    <ul class="container-site flex flex-col gap-0 py-4">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="mobile-nav-link block py-3 text-sm font-semibold uppercase tracking-wider border-b border-[var(--color-surface-low)] hover:text-[var(--color-primary)] transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="pt-3">
        <a
          href="https://www.instagram.com/anavalverdenutrideportiva"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider hover:text-[var(--color-primary)] transition-colors"
        >
          Instagram
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const nav = document.getElementById('main-nav');
  const toggle = document.getElementById('nav-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  // Scroll blur
  window.addEventListener('scroll', () => {
    if (window.scrollY > 80) {
      nav?.classList.add('nav-scrolled');
    } else {
      nav?.classList.remove('nav-scrolled');
    }
  }, { passive: true });

  // Hamburger toggle
  toggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('hidden') === false;
    mobileMenu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  // Cerrar menú mobile al hacer click en un link
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  #main-nav {
    color: var(--color-on-surface);
    background: #e3dfdc;
  }

  #main-nav.nav-scrolled {
    box-shadow: 0 1px 0 var(--color-surface-high);
  }

  .nav-inner {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-right: 1.5rem;
  }

  @media (min-width: 768px) {
    .nav-inner { padding-right: 2rem; }
  }

  .logo-img {
    border-radius: 50%;
  }
</style>
