---
const navLinks = [
  { href: '/#servicios',   label: 'Servicios' },
  { href: '/#testimonios', label: 'Testimonios' },
  { href: '/#faq',         label: 'FAQ' },
  { href: '/#reserva',     label: 'Reservar turno' },
];
---

<header id="main-nav" class="fixed top-0 left-0 right-0 z-50">
  <div class="nav-inner flex items-center justify-between">

    <!-- Marca -->
    <a href="/" aria-label="Ana Valverde Nutrición Deportiva — Inicio" class="brand-link shrink-0">
      <span class="brand-name">Ana Valverde</span>
      <span class="brand-sep">/</span>
      <span class="brand-tagline">Nutrición Deportiva</span>
    </a>

    <!-- Links desktop -->
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="nav-link text-sm font-semibold uppercase tracking-wider">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Instagram -->
    <a
      href="https://www.instagram.com/anavalverdenutrideportiva"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram de Ana Valverde Nutrición Deportiva"
      class="nav-link nav-ig hidden md:flex items-center gap-2 text-sm font-semibold uppercase tracking-wider pr-6"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
      </svg>
      Instagram
    </a>

    <!-- Hamburger mobile -->
    <button
      id="nav-toggle"
      class="md:hidden flex flex-col gap-1.5 p-2 mr-4"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
    >
      <span class="ham-line ham-line-1"></span>
      <span class="ham-line ham-line-2"></span>
      <span class="ham-line ham-line-3"></span>
    </button>
  </div>

  <!-- Menú mobile -->
  <div id="mobile-menu" class="md:hidden mobile-menu-panel">
    <ul class="mobile-menu-list">
      {navLinks.map((link, i) => (
        <li style={`--i: ${i}`}>
          <a href={link.href} class="mobile-nav-link">
            {link.label}
          </a>
        </li>
      ))}
      <li style="--i: 4">
        <a
          href="https://www.instagram.com/anavalverdenutrideportiva"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-nav-link"
        >
          Instagram
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const nav        = document.getElementById('main-nav');
  const toggle     = document.getElementById('nav-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  function updateNav() {
    if (window.scrollY > 60) {
      nav?.classList.add('nav-scrolled');
    } else {
      nav?.classList.remove('nav-scrolled');
    }
  }
  updateNav();
  window.addEventListener('scroll', updateNav, { passive: true });

  toggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('is-open');
    mobileMenu?.classList.toggle('is-open');
    toggle.classList.toggle('menu-open');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.remove('is-open');
      toggle?.classList.remove('menu-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  /* ── Nav base: transparente sobre hero blanco → texto negro ── */
  #main-nav {
    background: transparent;
    color: #1a1a1a;
    transition: background 0.4s ease, box-shadow 0.4s ease, color 0.4s ease;
  }

  /* ── Al hacer scroll: fondo verde, texto blanco ── */
  #main-nav.nav-scrolled {
    background: #4A7C59;
    color: #fff;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.15);
  }

  /* ── Inner layout ── */
  .nav-inner {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-top: 0.85rem;
    padding-bottom: 1rem;
    padding-inline-start: 0.5rem;
    padding-inline-end: 1.5rem;
  }

  @media (min-width: 768px) {
    .nav-inner {
      padding-top: 1rem;
      padding-bottom: 1.2rem;
      padding-inline-start: 0.5rem;
      padding-inline-end: 2rem;
    }
  }

  /* ── Marca ── */
  .brand-link {
    display: flex;
    flex-direction: row;
    align-items: center;
    line-height: 1;
    text-decoration: none;
    gap: 0.5rem;
  }

  .brand-name {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1.1rem, 1.8vw, 1.55rem);
    color: #335c43;
    letter-spacing: 0.01em;
    transition: color 0.4s ease;
  }

  .brand-sep {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-weight: 300;
    font-size: clamp(0.9rem, 1.4vw, 1.2rem);
    color: rgba(51, 92, 67, 0.45);
    line-height: 1;
    transition: color 0.4s ease;
  }

  .brand-tagline {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1.1rem, 1.8vw, 1.55rem);
    color: #335c43;
    letter-spacing: 0.01em;
    transition: color 0.4s ease;
  }

  /* Al hacer scroll: marca en blanco */
  #main-nav.nav-scrolled .brand-name    { color: #fff; }
  #main-nav.nav-scrolled .brand-sep     { color: rgba(255, 255, 255, 0.5); }
  #main-nav.nav-scrolled .brand-tagline { color: #fff; }

  /* ── Links: heredan color del nav ── */
  .nav-link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .nav-link:hover {
    opacity: 0.6;
  }

  /* ── Hamburger lines ── */
  .ham-line {
    display: block;
    width: 24px;
    height: 2px;
    background-color: currentColor;
    border-radius: 2px;
    transform-origin: center;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                opacity   0.25s ease;
  }

  #nav-toggle.menu-open .ham-line-1 { transform: translateY(8px) rotate(45deg); }
  #nav-toggle.menu-open .ham-line-2 { opacity: 0; transform: scaleX(0); }
  #nav-toggle.menu-open .ham-line-3 { transform: translateY(-8px) rotate(-45deg); }

  /* ── Brand: más pequeño en mobile para evitar superposición ── */
  @media (max-width: 767px) {
    .brand-name,
    .brand-tagline {
      font-size: clamp(0.85rem, 3.8vw, 1.1rem);
    }
    .brand-sep {
      font-size: 0.8rem;
    }
    .brand-link {
      gap: 0.3rem;
    }
  }

  /* ── Menú mobile ── */
  .mobile-menu-panel {
    background: transparent;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition: max-height 0.42s cubic-bezier(0.4, 0, 0.2, 1),
                opacity    0.32s ease,
                background 0.4s ease;
  }

  .mobile-menu-panel.is-open {
    max-height: 520px;
    opacity: 1;
  }

  #main-nav.nav-scrolled .mobile-menu-panel {
    background: #4A7C59;
    border-top-color: rgba(255, 255, 255, 0.15);
  }

  .mobile-menu-list {
    list-style: none;
    padding: 0.1rem 1.75rem 1rem;
    display: flex;
    flex-direction: column;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.35rem 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: #1a1a1a;
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    transition: color 0.2s ease, padding-left 0.2s ease;
  }

  .mobile-nav-link:hover {
    color: #335c43;
    padding-left: 0.4rem;
  }

  #main-nav.nav-scrolled .mobile-nav-link {
    color: #ffffff;
    border-bottom-color: rgba(255, 255, 255, 0.15);
  }

  #main-nav.nav-scrolled .mobile-nav-link:hover {
    color: rgba(255, 255, 255, 0.75);
  }

  .mobile-menu-panel li {
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.28s ease calc(var(--i) * 50ms),
                transform 0.28s ease calc(var(--i) * 50ms);
  }

  .mobile-menu-panel.is-open li {
    opacity: 1;
    transform: translateY(0);
  }
</style>
